<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.CodecInfo.Starting"
        tools:ignore="MissingApplicationIcon"
        tools:replace="android:theme">

        <activity
            android:name=".ui.WearMainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.WearSearchActivity"
            android:label="@string/action_search"
            android:parentActivityName=".ui.WearMainActivity"
            android:theme="@style/Theme.CodecInfo"
            android:taskAffinity="" />

        <activity
            android:name=".ui.settings.WearSettingsActivity"
            android:label="@string/action_settings"
            android:parentActivityName=".ui.WearMainActivity"
            android:theme="@style/Theme.CodecInfo"
            android:taskAffinity="" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <service
            android:name=".ui.tiles.CodecInfoTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher_round" />
        </service>

    </application>

</manifest>