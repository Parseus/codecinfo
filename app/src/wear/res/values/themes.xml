<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CodecInfo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground" tools:ignore="PrivateResource">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/Theme.CodecInfo</item>
    </style>

    <style name="Theme.CodecInfo" parent="Base.Theme.CodecInfo">
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorOnPrimary" tools:ignore="PrivateResource">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryContainer">@color/teal_700</item>
        <item name="colorOnSecondary" tools:ignore="PrivateResource">@color/black</item>
        <item name="colorError">@color/red_200</item>
        <item name="colorSurface" tools:ignore="PrivateResource">@color/black</item>
    </style>

    <style name="Platform.V23.Theme.CodecInfo" parent="Theme.Material3Expressive.Dark.NoActionBar" />

</resources>